# Runtime mode. Use HOSTED for an external full MIMIC-IV PostgreSQL database.
MIMICWIZARD_INTERACTIVE=false
MIMICWIZARD_MODE=HOSTED
MIMICWIZARD_PORT=3838
MIMICWIZARD_CACHE_DIR=/var/cache/mimicwizard

# Optional MIMIC-IV schemas.
MIMICWIZARD_IS_ED_LOADED=false
MIMICWIZARD_IS_NOTE_LOADED=false

# Full MIMIC-IV PostgreSQL database. Set a real password only in your local .env file
# or through your deployment platform's secret mechanism.
MIMICWIZARD_HOSTED_DBNAME=mimiciv
MIMICWIZARD_HOSTED_HOST=postgres.example.org
MIMICWIZARD_HOSTED_PORT=5432
MIMICWIZARD_HOSTED_USER=mimicwizard
MIMICWIZARD_HOSTED_PASSWORD=replace-with-a-secret

# Demo PostgreSQL database. In a container, localhost refers to the container itself.
MIMICWIZARD_DEMO_DBNAME=postgres
MIMICWIZARD_DEMO_HOST=postgres.example.org
MIMICWIZARD_DEMO_PORT=5432
MIMICWIZARD_DEMO_USER=postgres
MIMICWIZARD_DEMO_PASSWORD=